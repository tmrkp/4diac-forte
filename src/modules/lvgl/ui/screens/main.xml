<screen>
    <styles>
        <style name="inactive" bg_color="0xff00ff" />
        <style name="active" bg_color="0x00ffff" transform_rotation="450" transform_pivot_x="20" transform_pivot_y="20" />
    </styles>
    <view width="100%" height="100%" style_layout="flex" flex_flow="column" style_pad_row="20" style_pad_column="40" style_pad_all="40" style_border_width="0">
        <lv_obj width="100%" height="content" style_pad_all="20" style_layout="flex" style_flex_main_place="space_between" style_flex_cross_place="center">
            <lv_button name="lvbutton1" bind_state_if_not_eq="subject1 disabled 1">
                <lv_label text="Toggle Button" />
            </lv_button>
            <lv_obj width="content" height="content" style_border_width="0" name="led_inject_1">
            </lv_obj>
        </lv_obj>
        <lv_obj width="100%" height="content" style_pad_all="20" style_layout="flex" style_flex_main_place="space_between" style_flex_cross_place="center">
            <lv_slider name="lvslider1" width="180"></lv_slider>
            <lv_bar width="180" name="lvbar1"></lv_bar>
        </lv_obj>
        <lv_obj width="100%" height="content" style_pad_all="20" style_layout="flex" style_flex_main_place="space_between" style_flex_cross_place="center">
            <lv_dropdown name="lvdropdown1">
            </lv_dropdown>
            <lv_label name="lvlabel1" text="0"></lv_label>
        </lv_obj>
        <lv_obj width="100%" height="content" style_pad_all="20" style_layout="flex" style_flex_main_place="space_between" style_flex_cross_place="center">
            <lv_obj width="content" height="content" style_border_width="0" name="switch_inject_1">
            </lv_obj>
            <lv_obj width="40" height="40" style_border_width="0" styles="inactive active:checked" bind_state_if_eq="subject1 checked 1">
            </lv_obj>
        </lv_obj>
    </view>
</screen>

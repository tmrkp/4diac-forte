<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:data="org.eclipse.fordiac.ide.model.datatype" xmlns:libraryElement="org.eclipse.fordiac.ide.model.libraryElement" xmlns:stalgorithm="http://www.eclipse.org/fordiac/ide/structuredtextalgorithm/STAlgorithm" xmlns:xmiexport="http://www.eclipse.org/fordiac/ide/xmiexport/XMIExport">
  <stalgorithm:STAlgorithmSource/>
  <libraryElement:ServiceInterfaceFBType name="LVGLMaster" comment="Service Interface Function Block Type">
    <versionInfo author="tim" date="2025-05-16" version="1.0"/>
    <identification standard="61499-2"/>
    <compilerInfo/>
    <interfaceList>
      <eventInputs name="INIT" isInput="true">
        <type xsi:type="data:EventType" href="EInit.eventlib.dtp#/"/>
        <with variables="/1/@interfaceList/@inputVars.0"/>
      </eventInputs>
      <eventOutputs name="INITO">
        <type xsi:type="data:EventType" href="EInit.eventlib.dtp#/"/>
        <with variables="/1/@interfaceList/@outputVars.0"/>
        <with variables="/1/@interfaceList/@outputVars.1"/>
      </eventOutputs>
      <eventOutputs name="IND">
        <type xsi:type="data:EventType" href="Event.eventlib.dtp#/"/>
        <with variables="/1/@interfaceList/@outputVars.0"/>
        <with variables="/1/@interfaceList/@outputVars.1"/>
      </eventOutputs>
      <inputVars name="QI" isInput="true" withs="/1/@interfaceList/@eventInputs.0/@with.0">
        <type xsi:type="data:BoolType" href="data.lib#/12"/>
      </inputVars>
      <outputVars name="QO" withs="/1/@interfaceList/@eventOutputs.1/@with.0 /1/@interfaceList/@eventOutputs.0/@with.0">
        <type xsi:type="data:BoolType" href="data.lib#/12"/>
      </outputVars>
      <outputVars name="STATUS" withs="/1/@interfaceList/@eventOutputs.1/@with.1 /1/@interfaceList/@eventOutputs.0/@with.1">
        <type xsi:type="data:WstringType" href="data.lib#/18"/>
      </outputVars>
      <plugs name="BusAdapterOut" adapterFB="/1/@interfaceList/@plugs.0/@interfaceOnlyAdapterFB">
        <type xsi:type="libraryElement:AdapterType" href="platform:/resource/HMITypesDemo/Type%20Library/LVGLBusAdapter.adp#/"/>
        <interfaceOnlyAdapterFB name="BusAdapterOut" adapterDecl="/1/@interfaceList/@plugs.0">
          <position/>
          <interface>
            <eventInputs name="INIT" isInput="true">
              <type xsi:type="data:EventType" href="EInit.eventlib.dtp#/"/>
              <with variables="/1/@interfaceList/@plugs.0/@interfaceOnlyAdapterFB/@interface/@inputVars.0"/>
              <with variables="/1/@interfaceList/@plugs.0/@interfaceOnlyAdapterFB/@interface/@inputVars.1"/>
              <with variables="/1/@interfaceList/@plugs.0/@interfaceOnlyAdapterFB/@interface/@inputVars.2"/>
            </eventInputs>
            <eventOutputs name="INITO">
              <type xsi:type="data:EventType" href="EInit.eventlib.dtp#/"/>
              <with variables="/1/@interfaceList/@plugs.0/@interfaceOnlyAdapterFB/@interface/@outputVars.0"/>
            </eventOutputs>
            <inputVars name="QI" isInput="true" withs="/1/@interfaceList/@plugs.0/@interfaceOnlyAdapterFB/@interface/@eventInputs.0/@with.0">
              <type xsi:type="data:BoolType" href="data.lib#/12"/>
              <value/>
            </inputVars>
            <inputVars name="MasterId" isInput="true" withs="/1/@interfaceList/@plugs.0/@interfaceOnlyAdapterFB/@interface/@eventInputs.0/@with.1">
              <type xsi:type="data:UintType" href="data.lib#/3"/>
              <value/>
            </inputVars>
            <inputVars name="Index" isInput="true" withs="/1/@interfaceList/@plugs.0/@interfaceOnlyAdapterFB/@interface/@eventInputs.0/@with.2">
              <type xsi:type="data:UintType" href="data.lib#/3"/>
              <value/>
            </inputVars>
            <outputVars name="QO" withs="/1/@interfaceList/@plugs.0/@interfaceOnlyAdapterFB/@interface/@eventOutputs.0/@with.0">
              <type xsi:type="data:BoolType" href="data.lib#/12"/>
              <value/>
            </outputVars>
          </interface>
        </interfaceOnlyAdapterFB>
      </plugs>
    </interfaceList>
    <service>
      <rightInterface name="RESOURCE"/>
      <leftInterface name="APPLICATION"/>
      <serviceSequence name="normal_establishment">
        <serviceTransaction>
          <inputPrimitive event="INIT+" parameters="PARAMS" interface="/1/@service/@leftInterface"/>
          <outputPrimitive event="initialize" parameters="PARAMS" interface="/1/@service/@rightInterface"/>
          <outputPrimitive event="INITO+" interface="/1/@service/@leftInterface"/>
        </serviceTransaction>
      </serviceSequence>
      <serviceSequence name="unsuccessful_establishment">
        <serviceTransaction>
          <inputPrimitive event="INIT+" parameters="PARAMS" interface="/1/@service/@leftInterface"/>
          <outputPrimitive event="initialize" parameters="PARAMS" interface="/1/@service/@rightInterface"/>
          <outputPrimitive event="INITO-" parameters="STATUS" interface="/1/@service/@leftInterface"/>
        </serviceTransaction>
      </serviceSequence>
      <serviceSequence name="request_confirm">
        <serviceTransaction>
          <inputPrimitive event="REQ+" parameters="SD" interface="/1/@service/@leftInterface"/>
          <outputPrimitive event="request" parameters="SD" interface="/1/@service/@rightInterface"/>
          <outputPrimitive event="CNF+" parameters="RD" interface="/1/@service/@leftInterface"/>
        </serviceTransaction>
      </serviceSequence>
      <serviceSequence name="request_inhibited">
        <serviceTransaction>
          <inputPrimitive event="REQ-" parameters="SD" interface="/1/@service/@leftInterface"/>
          <outputPrimitive event="CNF-" parameters="STATUS" interface="/1/@service/@leftInterface"/>
        </serviceTransaction>
      </serviceSequence>
      <serviceSequence name="request_error">
        <serviceTransaction>
          <inputPrimitive event="REQ+" parameters="SD" interface="/1/@service/@leftInterface"/>
          <outputPrimitive event="request" parameters="SD" interface="/1/@service/@rightInterface"/>
          <outputPrimitive event="CNF-" parameters="STATUS" interface="/1/@service/@leftInterface"/>
        </serviceTransaction>
      </serviceSequence>
      <serviceSequence name="indication_response">
        <serviceTransaction>
          <inputPrimitive event="indicate" parameters="RD" interface="/1/@service/@rightInterface"/>
          <outputPrimitive event="IND+" parameters="RD" interface="/1/@service/@leftInterface"/>
        </serviceTransaction>
        <serviceTransaction>
          <inputPrimitive event="RSP" parameters="QI,SD" interface="/1/@service/@leftInterface"/>
          <outputPrimitive event="response" parameters="QI,SD" interface="/1/@service/@rightInterface"/>
        </serviceTransaction>
      </serviceSequence>
      <serviceSequence name="indication_inhibited">
        <serviceTransaction>
          <inputPrimitive event="indicate" parameters="RD,QI=FALSE" interface="/1/@service/@rightInterface"/>
          <outputPrimitive event="inhibited" interface="/1/@service/@rightInterface"/>
        </serviceTransaction>
      </serviceSequence>
      <serviceSequence name="error_indication">
        <serviceTransaction>
          <inputPrimitive event="error" parameters="STATUS" interface="/1/@service/@rightInterface"/>
          <outputPrimitive event="IND-" parameters="STATUS" interface="/1/@service/@leftInterface"/>
        </serviceTransaction>
      </serviceSequence>
      <serviceSequence name="application_initiated_termination">
        <serviceTransaction>
          <inputPrimitive event="INIT-" interface="/1/@service/@leftInterface"/>
          <outputPrimitive event="terminate" interface="/1/@service/@rightInterface"/>
          <outputPrimitive event="INITO-" parameters="STATUS" interface="/1/@service/@leftInterface"/>
        </serviceTransaction>
      </serviceSequence>
      <serviceSequence name="resource_initiated_termination">
        <serviceTransaction>
          <outputPrimitive event="INITO-" parameters="STATUS" interface="/1/@service/@leftInterface"/>
        </serviceTransaction>
      </serviceSequence>
    </service>
  </libraryElement:ServiceInterfaceFBType>
  <xmiexport:XMIExportInitialValues/>
  <xmiexport:XMIExportTypeDeclarations/>
  <xmiexport:XMIExportAttributeValues/>
</xmi:XMI>
